# Copy to .env and fill in. Variable names come from app/config.py.

# --- Environment / logging ---
DEBUG=false
# ENVIRONMENT=production          # derived from DEBUG when unset
# LOG_LEVEL=INFO                  # DEBUG when DEBUG=true
LOG_FORMAT=json
# LOG_FILE=/app/logs/polizas.log

# --- API ---
API_PREFIX=/api/v1
# JSON list; empty = same-origin only (the dashboard needs nothing else)
CORS_ORIGINS=[]
# Optional external docs link in the dashboard sidebar
DOCS_URL=

# --- SQL Server core system (read access + UPDATE on timpresion_pdf for mark-sent) ---
SQLSERVER_HOST=sqlserver.example.com
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=insurance_core
SQLSERVER_USER=polizas_reader
SQLSERVER_PASSWORD=change-me
SQLSERVER_DRIVER=FreeTDS
SQLSERVER_TDS_VERSION=7.3

# --- Redis cache ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
# REDIS_PASSWORD=
CACHE_TTL_HOURS=24
CACHE_WARMUP_DAYS=730
CACHE_SYNC_INTERVAL_MINUTES=5

# --- Identity service (token validation) ---
IDENTITY_SERVICE_URL=http://localhost:8080/api/v1
# Browser-reachable URL (Swagger UI and dashboard login); falls back to IDENTITY_SERVICE_URL
IDENTITY_EXTERNAL_URL=http://localhost:8080/api/v1

# --- Policy PDFs ---
# Container path where the UNC share (e.g. \\fileserver\policies) is mounted
LOCAL_PATH_PREFIX=/media/polizas
# JSON list of path prefixes on shares that are not mounted (files reported as excluded)
EXCLUDED_PATHS=[]
